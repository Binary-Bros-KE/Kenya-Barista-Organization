  "philosophy": {
    "title": "experience love at first sip",
    "values": [
      {
        "title": "Care",
        "src": "/legacy/care.f17f39e1.png",
        "text": "We show care throughout our full cycle of the industry, our local community, baristas, roasters, producers and delivering exceptional solutions affecting the coffee chain"
      },
      {
        "title": "Entrepreneurial Spirit",
        "src": "/legacy/entrepreneur.062c62e2.png",
        "text": "We treat challenges as opportunities, problem-solve & work creativity to get things done "
      },
      {
        "title": "A.b.m.f",
        "src": "/legacy/connections.78038315.jpg",
        "text": "Strangers are simply friends we haven’t made yet; we seek new connections & look for the win-win in every situation"
      },
      {
        "title": "Teamwork",
        "src": "/legacy/teamwork.e6f6b290.jpg",
        "text": "To collaborate, cooperate, communicate and work together. Developing valued partnerships with our partners"
      },
      {
        "title": "Dependable",
        "src": "/legacy/dependable.4d9b8bc7.jpg",
        "text": "To be reliable, loyal and trustworthy, guaranteeing that we can be counted on, no matter what in order to deliver the promises"
      },
      {
        "title": "Openness",
        "src": "/legacy/openness.311bf081.jpg",
        "text": "K.B.O believes that transparency and accountability, communication coupled with innovation are key in meeting expectations."
      },
      {
        "title": "Fairness",
        "src": "/legacy/fairness.5593d9a5.png",
        "text": "At K.B.O, we believe that all men and women including the youth need to be given opportunities to improve or maintain their wellbeing. We apply methods that encourage the participation of all baristas in knowledge, growth and skills to fully participate in processes, and above all promote active listening to and respecting everyone’s opinions."
      },
      {
        "title": "Feedback",
        "src": "/legacy/feedback.png",
        "text": "We acknowledge that providing timely responses and constant communication is key in building long term business relations and working partnership."
      },
      {
        "title": "Efficiency",
        "src": "/legacy/efficient.e5bba094.png",
        "text": "K.B.O believes that Professional attitude and being honest together with ensuring that people have what they need to perform” is key in meeting everyone’s expectations. It also believes in developing a strong staff team, driven by their respective set key performance targets, but all aimed at feeding into the K.B.O mission and vision. This is by encouraging self-growth and self-respect among Ourselves and partners."
      },
      {
        "title": "Equality",
        "src": "/legacy/equality.970c0f62.jpg",
        "text": "In order to achieve dignity K.B.O cultivates a culture of respect by promoting “treating everyone the way you want to be treated, and dealt with transparently."
      }
    ],
    "philosophy": [
      {
        "title": "Purpose",
        "text": "Game changer in coffee industry "
      },
      {
        "title": "Our Mission",
        "text": "To inspire and nurture youth in coffee skills profession"
      },
      {
        "title": "Our Vision",
        "text": "To establish Kenya Barista Organization as a Premier Barista Guild in Africa"
      }
    ]
  },
