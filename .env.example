# Local development only; never use these sample settings on a public server.
NODE_ENV=development
APP_URL=http://localhost:3000
# Matches docker-compose.yml. For Prisma dev, use its printed connection URL instead.
DATABASE_URL=postgresql://barista:local_development_only@127.0.0.1:5433/barista?schema=public
DATABASE_POOL_MAX=5
AUTH_SECRET=
PAYMENT_ENCRYPTION_KEY=
PAYMENT_CALLBACK_BASE_URL=
PRIVATE_UPLOAD_DIR=.private-uploads
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
LOG_LEVEL=info
EMAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
