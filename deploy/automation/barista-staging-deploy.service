[Unit]
Description=Deploy verified Kenya Barista staging commits
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=evans
Group=evans
WorkingDirectory=/home/evans/barista-platform/repository
ExecStart=/usr/bin/flock -n -E 0 /home/evans/barista-platform/shared/deploy.lock /home/evans/barista-platform/runtime/node/bin/node /home/evans/barista-platform/repository/deploy/automation/poll-deploy.mjs
TimeoutStartSec=35min
UMask=0077
Nice=10
CPUQuota=200%
MemoryMax=6G
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/evans/barista-platform
# Scoped sudo restarts are required; NoNewPrivileges would prevent them.
NoNewPrivileges=false
